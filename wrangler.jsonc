{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domain-manager",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "domain-manager",
      // 换成你自己的：wrangler d1 create domain-manager
      "database_id": "d43a8281-5ac1-4b76-953f-806972a11cae"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
